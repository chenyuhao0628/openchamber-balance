{
  "name": "openchamber-balance",
  "version": "0.2.8",
  "private": true,
  "type": "module",
  "description": "OpenChamber 余额与额度：清晰总览、中转站管理与可靠的手动刷新。",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.24.0"
    },
    "contributes": {
      "panel": {
        "id": "balance",
        "name": "余额",
        "icon": "bank-card",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "panel/section.html",
        "title": "余额",
        "height": 240
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {}
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.*",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.5.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "panel/",
    "service/",
    "README.md"
  ]
}
